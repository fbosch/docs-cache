{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": [
		"src/api.ts",
		"src/cli/index.ts",
		"src/cache/lock.ts",
		"build.config.ts"
	],
	"ignorePatterns": ["tests/**"],
	"audit": {
		"gate": "new-only"
	},
	"health": {
		"maxCyclomatic": 20,
		"coverage": "coverage/coverage-final.json"
	}
}
