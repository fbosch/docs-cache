{
	"name": "docs-cache",
	"private": false,
	"type": "module",
	"version": "0.6.0",
	"packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
	"description": "CLI for deterministic local caching of external documentation for agents and tools",
	"author": "Frederik Bosch",
	"license": "MIT",
	"homepage": "https://github.com/fbosch/docs-cache#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/fbosch/docs-cache.git"
	},
	"bugs": {
		"url": "https://github.com/fbosch/docs-cache/issues"
	},
	"keywords": [
		"docs",
		"documentation",
		"cache",
		"agent",
		"ai",
		"git",
		"cli"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"docs-cache": "./bin/docs-cache.mjs"
	},
	"files": [
		"bin",
		"dist/cli.mjs",
		"dist/esm/**/*.mjs",
		"dist/esm/**/*.d.ts",
		"dist/lock.mjs",
		"dist/shared/*.mjs",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"dev": "pnpm build",
		"lint": "biome check .",
		"prepublishOnly": "pnpm audit --audit-level=high && pnpm build && pnpm size && pnpm schema:build",
		"release": "pnpm run lint && pnpm run typecheck && bumpp && pnpm publish --access public",
		"test": "pnpm build && node --test --test-concurrency=1",
		"test:coverage": "DOCS_CACHE_COVERAGE=1 c8 --include src --reporter=text --reporter=json node --conditions=coverage --import tsx --experimental-loader ./scripts/coverage-loader.mjs --test --test-concurrency=1",
		"bench": "pnpm build && node scripts/benchmarks/run.mjs",
		"complexity": "node scripts/complexity/run.mjs",
		"fallow": "fallow",
		"fallow:audit": "fallow audit",
		"schema:build": "node scripts/generate-schema.mjs",
		"size": "size-limit",
		"test:watch": "node --test --watch",
		"typecheck": "tsc --noEmit",
		"prepare": "simple-git-hooks"
	},
	"imports": {
		"#cache/*": {
			"coverage": "./src/cache/*.ts",
			"types": "./dist/esm/cache/*.d.ts",
			"default": "./dist/esm/cache/*.mjs"
		},
		"#cli/*": {
			"coverage": "./src/cli/*.ts",
			"types": "./dist/esm/cli/*.d.ts",
			"default": "./dist/esm/cli/*.mjs"
		},
		"#commands/*": {
			"coverage": "./src/commands/*.ts",
			"types": "./dist/esm/commands/*.d.ts",
			"default": "./dist/esm/commands/*.mjs"
		},
		"#core/*": {
			"coverage": "./src/*.ts",
			"types": "./dist/esm/*.d.ts",
			"default": "./dist/esm/*.mjs"
		},
		"#config": {
			"coverage": "./src/config/index.ts",
			"types": "./dist/esm/config/index.d.ts",
			"default": "./dist/esm/config/index.mjs"
		},
		"#config/*": {
			"coverage": "./src/config/*.ts",
			"types": "./dist/esm/config/*.d.ts",
			"default": "./dist/esm/config/*.mjs"
		},
		"#git/*": {
			"coverage": "./src/git/*.ts",
			"types": "./dist/esm/git/*.d.ts",
			"default": "./dist/esm/git/*.mjs"
		},
		"#types/*": {
			"coverage": "./src/types/*.ts",
			"types": "./dist/esm/types/*.d.ts",
			"default": "./dist/esm/types/*.mjs"
		}
	},
	"dependencies": {
		"@clack/prompts": "1.0.0",
		"cac": "^6.7.14",
		"cli-truncate": "^4.0.0",
		"execa": "^9.6.1",
		"fast-glob": "^3.3.3",
		"log-update": "7.0.2",
		"picocolors": "^1.1.1",
		"picomatch": "^4.0.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@size-limit/file": "^12.0.1",
		"@types/node": "^25.6.0",
		"bumpp": "^11.0.1",
		"c8": "^10.1.3",
		"fallow": "3.3.0",
		"jiti": "^2.6.1",
		"lint-staged": "^16.4.0",
		"simple-git-hooks": "^2.13.1",
		"size-limit": "^12.0.1",
		"tinybench": "^6.0.0",
		"ts-complex": "^1.0.0",
		"tsx": "4.23.0",
		"typescript": "7.0.2"
	},
	"size-limit": [
		{
			"path": "dist/esm/cli/index.mjs",
			"limit": "20 kB"
		}
	],
	"complexity": {
		"maxCyclomatic": 20,
		"minMaintainability": 60,
		"top": 10
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm lint && pnpm lint-staged && pnpm typecheck",
		"pre-push": "pnpm lint"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"pnpm": {
		"overrides": {
			"defu@<=6.1.4": "6.1.5",
			"lodash@>=4.0.0 <=4.17.23": "4.18.0",
			"minimatch@>=10.0.0 <10.2.3": "10.2.4",
			"picomatch@<2.3.2": "2.3.2"
		}
	}
}
